---
interface Props { title: string; kicker?: string }
const { title, kicker } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<header class="site"><a href="/gift-guide">Maker&nbsp;Notes</a><nav><a href="/gift-guide">Guides</a><a href="/styles">Design</a><a href="/">About</a></nav></header>
		<article>
			{kicker && <p class="kicker">{kicker}</p>}
			<h1>{title}</h1>
			<slot />
		</article>
	</body>
</html>
<style is:global>
	body { margin: 0; font-family: Inter, system-ui, sans-serif; color: #1c211d; background: #fbfbf9; line-height: 1.7; }
	header.site { display: flex; justify-content: space-between; align-items: center; max-width: 56rem; margin: 0 auto; padding: 1.25rem; }
	header.site > a { font-family: Fraunces, serif; font-size: 1.35rem; color: inherit; text-decoration: none; }
	header.site nav { display: flex; gap: 1.5rem; }
	header.site nav a { color: #5b635c; text-decoration: none; font-size: .95rem; }
	article { max-width: 56rem; margin: 0 auto; padding: 1rem 1.25rem 6rem; }
	article > p, article > h2 { max-width: 42rem; }
	.kicker { color: #2f6b4f; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; margin: 2rem 0 .5rem; }
	h1 { font-family: Fraunces, Georgia, serif; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 1.25rem; }
	article h2 { font-family: Fraunces, Georgia, serif; font-size: 1.6rem; letter-spacing: -0.01em; margin: 3rem 0 .5rem; }
	article p { font-size: 1.08rem; color: #3a413b; }
	article a { color: #2f6b4f; text-decoration: underline; }
	article img { margin: 1.5em 0; border-radius: 4px; }
</style>
