---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<main><slot /></main>
	</body>
</html>
<style is:global>
	body { margin: 0; font-family: Inter, system-ui, sans-serif; color: #1c211d; background: #fbfbf9; line-height: 1.6; }
	main { max-width: 68rem; margin: 0 auto; padding: 3rem 1.25rem 6rem; }
	h1, h2.demo { font-family: Fraunces, Georgia, serif; letter-spacing: -0.02em; }
	h1 { font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 .5rem; }
	h2.demo { margin: 4rem 0 .25rem; font-size: 1.6rem; }
	p.lead { font-size: 1.15rem; color: #5b635c; max-width: 44rem; }
	code { font-size: .85em; background: #eef1ec; padding: .15em .4em; border-radius: 6px; }
	.dark-band { background: #0f1310; box-shadow: 0 0 0 100vmax #0f1310; clip-path: inset(0 -100vmax); margin-top: 3rem; padding: 1rem 0 3rem; color: #eef1ee; }
</style>
